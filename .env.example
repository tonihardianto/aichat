# Server Configuration
PORT=8080
COOKIE_SECURE=false
SESSION_SECRET=ganti-dengan-kunci-acak-minimal-32-karakter-untuk-produksi
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# MySQL Configuration
MYSQL_DSN=chatuser:chatpassword@tcp(127.0.0.1:3306)/chat?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chat
MYSQL_USER=chatuser
MYSQL_PASSWORD=chatpassword

# Local attachment storage
STORAGE_PATH=data/attachments

# AI Provider Configuration (OpenAI-compatible / Ollama)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_GUEST_MODEL=llama3.2
# Model yang dipilih otomatis untuk user baru (opsional, harus ada di daftar model)
# LLM_DEFAULT_MODEL=llama3.2

# ComfyUI lokal (tool generate_image)
COMFYUI_URL=http://127.0.0.1:8188

# Provider LLM tambahan (opsional). Salin providers.example.json ke providers.json.
# Model dari provider ini tampil di daftar sebagai "nama::model", mis. mac::qwen3:8b.
# Path default: providers.json (folder backend atau root). Ubah dengan:
# LLM_PROVIDERS_FILE=/path/ke/providers.json

# Generator gambar via API (menu Image Generator), format OpenAI /v1/images/generations
# IMAGE_API_URL=https://contoh.com/v1/images/generations
# IMAGE_API_KEY=
# IMAGE_MODELS=model-a,model-b
